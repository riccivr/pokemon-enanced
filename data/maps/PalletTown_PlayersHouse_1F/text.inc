PalletTown_PlayersHouse_1F_Text_MomGreeting::
    .string "MAMÁ: ¡{PLAYER}, mijo! Por fin te levantas.\n"
    .string "¿Vas a salir a la calle así?\l"
    .string "Ni te peinaste, chamo.\p"
    .string "Acuérdate de llevar suéter por si\n"
    .string "hace frío en la ruta.$"

PalletTown_PlayersHouse_1F_Text_MomYaVoyResponse::
    .string "MAMÁ: ¡Bueno, apúrate, mijo, que\n"
    .string "FrankieDeckard te mandó a llamar\l"
    .string "al laboratorio!$"

PalletTown_PlayersHouse_1F_Text_MomNoMeAcuerdoSueterResponse::
    .string "MAMÁ: ¡Dios mío, qué muchacho tan\n"
    .string "desmemoriado!\p"
    .string "Te lo pusiste ayer de bufanda,\n"
    .string "¡búscalo en el clóset!$"

PalletTown_PlayersHouse_1F_Text_MomNoMeAcuerdoQuienEresResponse::
    .string "MAMÁ: ¿¡Que no te acuerdas quién soy!?\p"
    .string "¡Una limpia con la chola es lo que\n"
    .string "te voy a dar para refrescarte la memoria,\l"
    .string "carricito!$"

PalletTown_PlayersHouse_1F_Text_YouShouldTakeQuickRest::
    .string "MAMÁ: ¡{PLAYER}, mijo!\n"
    .string "Descansa un ratico para que tus bichos\l"
    .string "se recuperen.$"

PalletTown_PlayersHouse_1F_Text_LookingGreatTakeCare::
    .string "MAMÁ: ¡Listo, mijo! Quedaron como nuevos.\n"
    .string "¡Acuérdate de no pasar pena en la calle!$"

PalletTown_PlayersHouse_1F_Text_MovieOnTVFourBoysOnRailroad::
    .string "There's a movie on TV.\n"
    .string "Four boys are walking on railroad\l"
    .string "tracks.\p"
    .string "…I better go, too.$"

PalletTown_PlayersHouse_1F_Text_MovieOnTVGirlOnBrickRoad::
    .string "There's a movie on TV.\n"
    .string "A girl with her hair in pigtails is\l"
    .string "walking up a brick road.\p"
    .string "…I better go, too.$"

PalletTown_PlayersHouse_1F_Text_OopsWrongSide::
    .string "Oops, wrong side…$"

